# Runtime on/off switch. Flip to "off" to disable Slack approval entirely
# (hook returns immediately, no bridge spawn). One line covers all 3 hooks.
TO_SLACK=on

# Slack Bot Token: Slack App → OAuth & Permissions → "Bot User OAuth Token"
# Required scopes: chat:write, im:write
SLACK_BOT_TOKEN=xoxb-...

# Slack App-Level Token: Slack App → Basic Information → "App-Level Tokens"
# Required scope: connections:write
SLACK_APP_TOKEN=xapp-...

# Slack User ID to DM and accept approvals from.
# Slack profile → "..." → "Copy member ID"
SLACK_USER_ID=U0000000000

# Optional: comma-separated list of Slack User IDs allowed to approve.
# If omitted, defaults to SLACK_USER_ID only.
# ALLOWED_SLACK_USER_IDS=U0000000000,U1111111111

# Optional tuning (sane defaults if omitted):
# CLAUDE_SLACK_BRIDGE_PORT=3737
# CLAUDE_SLACK_IDLE_TIMEOUT=300       # seconds; bridge exits after this with 0 sessions
# CLAUDE_SLACK_APPROVAL_TTL=300       # seconds; pending approvals expire after this
